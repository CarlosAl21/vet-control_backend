# Copy to .env and fill in real values. Never commit .env.

# App
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=public
# "true" enables SSL (rejectUnauthorized: false)
DB_SSL=false

# Auth (JWT_SECRET is required; the app refuses to boot without it)
JWT_SECRET=
JWT_EXPIRES_IN=6h

# Mail (Gmail SMTP; use an app password, not the account password)
MAIL_USER=
MAIL_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=